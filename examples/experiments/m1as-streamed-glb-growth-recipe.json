{
  "schemaVersion": "m1as-growth-recipe/1.0",
  "id": "streamed-glb-growth-smoke-test",
  "title": "Streamed GLB Growth Smoke Test",
  "description": "Applies two explicit growth commands to the currently mounted GLB using the existing M1AS VFX growth queue. Commands are submitted in listed order.",
  "subject": {
    "assetKind": "glb",
    "assetSource": "currently-mounted-m1as-stream"
  },
  "execution": {
    "model": "m1as-vfx-queue",
    "mode": "submit_in_order"
  },
  "commands": [
    {
      "kind": "discrete",
      "commandId": "recipe-growth-001",
      "stimulus": "Consumption",
      "amount": {
        "kind": "relative_change",
        "fraction": 0.1
      }
    },
    {
      "kind": "discrete",
      "commandId": "recipe-growth-002",
      "stimulus": "Buff",
      "amount": {
        "kind": "relative_change",
        "fraction": 0.05
      }
    }
  ]
}
